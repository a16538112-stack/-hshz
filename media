<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MANW Gallery</title>
<style>
*{box-sizing:border-box}
body{
margin:0;
background:#08080c;
color:white;
font-family:Tahoma,Arial;
}
header{
background:linear-gradient(135deg,#190008,#08080c);
padding:35px 10px;
text-align:center;
border-bottom:2px solid #ff003c;
}
header h1{
font-size:48px;
color:#ff003c;
text-shadow:0 0 20px red;
margin:0;
letter-spacing:5px;
}
header p{color:#aaa}
.container{
max-width:1000px;
margin:auto;
padding:20px;
}
h2{
color:#ff1744;
text-align:center;
}
.buttons{
text-align:center;
margin:20px 0;
}
button{
background:#190b12;
color:white;
border:1px solid #ff1744;
padding:12px 22px;
border-radius:25px;
margin:5px;
cursor:pointer;
transition:0.3s;
}
button:hover{
background:#ff1744;
}
.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:15px;
}
.item{
background:#17131a;
border:1px solid #4b1726;
border-radius:12px;
overflow:hidden;
}
.item img,.item video{
width:100%;
height:280px;
object-fit:cover;
display:block;
cursor:pointer;
}
.item video{
object-fit:cover;
background:#000;
}
.name{
padding:12px;
text-align:center;
color:#ff647e;
font-weight:bold;
}
.viewer{
display:none;
position:fixed;
inset:0;
background:#000e;
align-items:center;
justify-content:center;
z-index:10;
}
.viewer img{
max-width:95%;
max-height:90%;
border-radius:8px;
}
</style>
</head>
<body>

<header>
<h1>MANW</h1>
<p>MY PRIVATE GALLERY</p>
</header>

<div class="container">

<h2>معرض الصور والفيديوهات</h2>

<div class="buttons">
<button onclick="filter('all')">الكل</button>
<button onclick="filter('photo')">الصور</button>
<button onclick="filter('video')">الفيديوهات</button>
</div>

<div class="gallery" id="gallery">

<div class="item" data-type="photo">
<img src="media/1000084714.png" onerror="this.src='https://via.placeholder.com/300?text=Image+Not+Found'" onclick="view(this.src)" alt="Photo 01">
<div class="name">Photo 01</div>
</div>

<div class="item" data-type="photo">
<img src="media/1000084710.png" onerror="this.src='https://via.placeholder.com/300?text=Image+Not+Found'" onclick="view(this.src)" alt="Photo 02">
<div class="name">Photo 02</div>
</div>

<div class="item" data-type="photo">
<img src="media/1000084711.jpg" onerror="this.src='https://via.placeholder.com/300?text=Image+Not+Found'" onclick="view(this.src)" alt="Photo 03">
<div class="name">Photo 03</div>
</div>

<div class="item" data-type="photo">
<img src="media/1000083809.jpg" onerror="this.src='https://via.placeholder.com/300?text=Image+Not+Found'" onclick="view(this.src)" alt="Photo 04">
<div class="name">Photo 04</div>
</div>

<div class="item" data-type="photo">
<img src="media/1000083730.jpg" onerror="this.src='https://via.placeholder.com/300?text=Image+Not+Found'" onclick="view(this.src)" alt="Photo 05">
<div class="name">Photo 05</div>
</div>

<div class="item" data-type="photo">
<img src="media/1000081385.png" onerror="this.src='https://via.placeholder.com/300?text=Image+Not+Found'" onclick="view(this.src)" alt="Photo 06">
<div class="name">Photo 06</div>
</div>

<div class="item" data-type="photo">
<img src="media/1000079206.jpg" onerror="this.src='https://via.placeholder.com/300?text=Image+Not+Found'" onclick="view(this.src)" alt="Photo 07">
<div class="name">Photo 07</div>
</div>

<div class="item" data-type="photo">
<img src="media/1000077903.jpg" onerror="this.src='https://via.placeholder.com/300?text=Image+Not+Found'" onclick="view(this.src)" alt="Photo 08">
<div class="name">Photo 08</div>
</div>

<div class="item" data-type="photo">
<img src="media/1000077900.jpg" onerror="this.src='https://via.placeholder.com/300?text=Image+Not+Found'" onclick="view(this.src)" alt="Photo 09">
<div class="name">Photo 09</div>
</div>

<div class="item" data-type="photo">
<img src="media/1000075904.jpg" onerror="this.src='https://via.placeholder.com/300?text=Image+Not+Found'" onclick="view(this.src)" alt="Photo 10">
<div class="name">Photo 10</div>
</div>

<div class="item" data-type="video">
<video controls playsinline>
<source src="media/1000081302.mp4" type="video/mp4">
متصفحك لا يدعم عرض الفيديو
</video>
<div class="name">Video 01</div>
</div>

</div>
</div>

<div class="viewer" id="viewer" onclick="this.style.display='none'">
<img id="bigImage" alt="Expanded View">
</div>

<script>
function filter(type){
document.querySelectorAll('.item').forEach(item=>{
item.style.display=
(type==='all'||item.dataset.type===type)
?'block':'none';
});
}

function view(src){
document.getElementById('bigImage').src=src;
document.getElementById('viewer').style.display='flex';
}
</script>

</body>
</html>
